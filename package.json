{
  "name": "koan",
  "version": "0.2.0",
  "description": "Koan is a general-purpose ReAct agent CLI and HTTP server for Node.js.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "koan": "./bin/koan.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch",
    "start": "node dist/index.js",
    "koan": "tsx bin/koan.dev.ts",
    "check:llm": "tsx examples/check-llm-connection.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "example": "tsx examples/basic.ts",
    "lint": "echo 'add eslint later'"
  },
  "keywords": [
    "react",
    "koan",
    "scaffold",
    "llm",
    "tools",
    "cli"
  ],
  "author": "Laucr",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "better-sqlite3": "^12.11.1",
    "gpt-tokenizer": "^2.9.0",
    "js-yaml": "^4.1.0",
    "openai": "^4.78.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.0"
  }
}
